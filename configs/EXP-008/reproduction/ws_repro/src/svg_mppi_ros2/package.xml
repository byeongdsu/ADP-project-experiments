<?xml version="1.0"?>
<package format="3">
  <name>svg_mppi_ros2</name><version>0.1.0</version>
  <description>Simulation-only ROS 2 adapter for kohonda SVG-MPPI CPU solvers.</description>
  <maintainer email="local@example.com">Simulation experiments</maintainer><license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend><depend>rclpy</depend><depend>grid_map_core</depend><depend>grid_map_ros</depend><depend>grid_map_msgs</depend>
  <depend>ackermann_msgs</depend><depend>nav_msgs</depend><depend>sensor_msgs</depend><depend>std_msgs</depend><depend>geometry_msgs</depend>
  <depend>yaml-cpp</depend><depend>eigen</depend>
  <exec_depend>python3-numpy</exec_depend><exec_depend>python3-scipy</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
